rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuth() { return request.auth != null; }
    function isOwner(uid) { return request.auth.uid == uid; }
    function isTeamMember(teamId) { 
        return request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.members; 
    }
    function isTeamAdmin(teamId) { 
        return request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.admins; 
    }

    // =====================================================
    // USER PROFILES
    // =====================================================
    match /userProfiles/{uid} {
      // NOTE: Firestore rules cannot query across collections to find if users share "any" team without a specific teamId.
      // Allowing authenticated users to read. In a real app we'd add `teamIds` array to the profile to filter.
      allow read: if isAuth();
      
      allow write: if isOwner(uid)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['publicProfile']) 
            || (
                request.resource.data.publicProfile.displayName is string
                && request.resource.data.publicProfile.displayName.size() <= 40
                && (request.resource.data.publicProfile.bio == null || (request.resource.data.publicProfile.bio is string && request.resource.data.publicProfile.bio.size() <= 300))
                && request.resource.data.publicProfile.skills is list
                && request.resource.data.publicProfile.skills.size() <= 10
                && request.resource.data.publicProfile.portfolioLinks is list
                && request.resource.data.publicProfile.portfolioLinks.size() <= 5
                && (request.resource.data.publicProfile.avatarURL == null || request.resource.data.publicProfile.avatarURL is string)
            ));
      allow delete: if false;
    }

    // =====================================================
    // TEAMS
    // =====================================================
    match /teams/{teamId} {
      allow create: if isAuth();
      allow read: if isAuth();

      allow update: if isAuth() && (
        // Rename team
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt']) && (request.auth.uid in resource.data.members || request.auth.uid in resource.data.admins)) ||
        // Join Request (pendingMembers)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingMembers']) && request.resource.data.pendingMembers.hasAll(resource.data.get('pendingMembers', [])) && isAuth()) ||
        // Approve Member
        (request.resource.data.diff(resource.data).affectedKeys().hasAny(['members', 'memberProfiles', 'pendingMembers']) && isTeamAdmin(teamId)) ||
        // Promote to Admin
        (request.resource.data.diff(resource.data).affectedKeys().hasAny(['admins']) && isTeamAdmin(teamId)) ||
        // Creator/Owner catchall
        resource.data.createdBy == request.auth.uid || 
        resource.data.adminId == request.auth.uid
      );

      allow delete: if isAuth() && request.auth.uid in resource.data.admins;
    }

    // =====================================================
    // HACKATHONS
    // =====================================================
    match /hackathons/{hackathonId} {
      allow create: if isAuth();
      allow read, update, delete: if isAuth() && (
        resource.data.ownerId == request.auth.uid || 
        isTeamMember(resource.data.teamId)
      );
    }

    // =====================================================
    // NOTIFICATIONS
    // =====================================================
    match /notifications/{notificationId} {
      allow read: if isAuth() && request.auth.uid == resource.data.userId;
      allow write: if isAuth();
      allow delete: if isAuth() && request.auth.uid == resource.data.userId;
    }

    // =====================================================
    // OTHER COLLECTIONS (Todos, Snippets, ActivityLogs, Users)
    // =====================================================
    match /users/{userId} {
      allow read, create: if isAuth();
      allow update, delete: if isOwner(userId);
    }

    match /todos/{todoId} {
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if isAuth() && (resource.data.ownerId == request.auth.uid || isTeamMember(resource.data.teamId));
    }

    match /snippets/{snippetId} {
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if isAuth() && (resource.data.ownerId == request.auth.uid || (resource.data.teamId != null && isTeamMember(resource.data.teamId)));
    }

    match /activityLogs/{logId} {
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow read: if isAuth() && (resource.data.ownerId == request.auth.uid || (resource.data.teamId != null && isTeamMember(resource.data.teamId)));
      allow update, delete: if false;
    }
  }
}
